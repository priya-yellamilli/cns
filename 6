import java.security.MessageDigest; 
class Sha1Ex 
{  
 public static void main(String args[]) 
 { 
  try 
  { 
  String msg = "Hello World"; // input message  
  MessageDigest md=  MessageDigest.getInstance("SHA-1"); // 
create message digest object  
  byte[] msgbytes = msg.getBytes(); // convert msg to byte array 
    
  byte[] digestbytes = md.digest(msgbytes); // compute digest 
 
  StringBuilder hexstring = new StringBuilder(); // convert byte array 
to hex  
   for(byte b: digestbytes ) 
   { 
    String hex = Integer.toHexString(0xff &b); 
 
    if(hex.length()==1) 
    { 
    hexstring.append('0'); 
    } 
    hexstring.append(hex); 
   } 
 
  System.out.println("Original Message: "+msg); 
  System.out.println("Message Digest: "+hexstring.toString()); 
  } 
  catch(Exception e)  
  { 
  } 
 } 
} 


